ENVIRONMENT=development
API_KEY=replace-with-a-long-random-secret-at-least-24-characters
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=mail@your-domain.com
SMTP_FROM_NAME=Techma Mail
SMTP_USE_TLS=false
SMTP_START_TLS=true
ALLOWED_FROM_DOMAINS=your-domain.com
MAX_RECIPIENTS=20
MAX_MESSAGE_BYTES=1000000
SMTP_TIMEOUT_SECONDS=20
